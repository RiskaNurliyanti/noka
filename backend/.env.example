APP_NAME=NOKA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Makassar
APP_URL=http://api.noka.test

# Frontend URL — dipakai CORS, Sanctum stateful domain, dan redirect Google OAuth
FRONTEND_URL=http://noka.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database UTAMA: Neon Postgres (aplikasi HANYA PERNAH membaca dari sini) ---
# Ambil connection string dari Neon Console > Project > Connection Details.
# Pakai endpoint "Direct connection" untuk migration, endpoint "Pooled connection"
# (host berakhiran -pooler) untuk .env production kalau trafiknya tinggi.
DB_CONNECTION=pgsql
DB_HOST=ganti-dengan-host-neon-anda.aws.neon.tech
DB_PORT=5432
DB_DATABASE=nokadb
DB_USERNAME=ganti_dengan_username_neon
DB_PASSWORD=ganti_dengan_password_neon
DB_SSLMODE=require

# --- Database CADANGAN (Stage 22): Supabase - dulu cuma dipakai sekali buat
# migrasi data lama (MigrateFromSupabase), sekarang dipakai lagi sebagai
# SALINAN CADANGAN best-effort (lihat App\Services\DualWriteMirror) - Neon di
# atas TETAP satu-satunya sumber kebenaran yang dibaca aplikasi. Kosongkan
# DB_LEGACY_HOST kalau tidak mau dual-write sama sekali (mirror otomatis
# di-skip, tidak ada error). Ambil dari Supabase Project Settings > Database.
DB_LEGACY_HOST=
DB_LEGACY_PORT=5432
DB_LEGACY_DATABASE=postgres
DB_LEGACY_USERNAME=postgres
DB_LEGACY_PASSWORD=

# --- Sanctum (SPA cookie auth, 1 domain + subdomain) ---
SANCTUM_STATEFUL_DOMAINS=noka.test,www.noka.test
SESSION_DOMAIN=.noka.test
SESSION_DRIVER=database
SESSION_LIFETIME=120

# --- Mail (buat verifikasi email & reset password) ---
# Kalau pakai Gmail: JANGAN pakai password akun Gmail biasa di MAIL_PASSWORD
# - Google SELALU menolaknya untuk SMTP ("535 Username and Password not
# accepted") walau passwordnya benar, karena akses SMTP polos seperti ini
# dianggap "less secure app" dan sudah diblokir Google. Yang WAJIB dipakai
# adalah App Password (password 16 karakter khusus, beda dari password
# login Gmail):
#   1. Aktifkan dulu Verifikasi 2 Langkah di akun Gmail itu (syarat mutlak
#      App Password muncul sebagai opsi) - https://myaccount.google.com/security
#   2. Buka https://myaccount.google.com/apppasswords, buat App Password baru
#      (nama bebas, mis. "NOKA Backend"), copy 16 karakter yang ditampilkan
#   3. Pakai email Gmail-nya di MAIL_USERNAME, 16 karakter App Password itu
#      (boleh dengan/tanpa spasi) di MAIL_PASSWORD - BUKAN password Gmail biasa
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@noka.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- Storage foto baru (upload lewat Laravel) - HARUS 'public', bukan 'local' ---
FILESYSTEM_DISK=public

CACHE_STORE=database
QUEUE_CONNECTION=database
